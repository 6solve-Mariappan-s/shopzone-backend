    NODE_ENV=development
   PORT=5001
   DATABASE_URL=postgres://<module_user>:<password>@localhost:5432/shopzone_auth
   JWT_SECRET=<shared-development-secret-at-least-32-characters>
   CORS_ORIGIN=http://localhost:3004
   API_GATEWAY_URL=http://localhost:5000
# Set both to bootstrap a super-admin; use a unique password of at least 16 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
    # Host, port, and sender have defaults; set SMTP_USER and SMTP_PASS to enable email.
    # Use a Google App Password here, not your regular account password.
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
